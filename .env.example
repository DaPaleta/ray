# Ray — environment template. Copy to .env and fill in the key.
# .gitignore excludes .env. Never commit a real key.

# --- Model (required for the agent; not required for the tests) ---

# The Anthropic key. Ray runs on Claude Haiku 4.5. See ADR-005 for the reason,
# and NOTES.md for the substitution against the brief.
OCEAN_ANTHROPIC_KEY=

# The model identifier.
RAY_MODEL=claude-haiku-4-5-20251001

# --- Data ---

# Path to the SQLite database. The default is the committed copy. See ADR-006.
RAY_DB_PATH=data/ocean_home_task.db

# --- Prompts ---

# The compiled reviewer prompt. See ADR-009.
# Ray falls back to the hand-written prompt when this file is absent.
RAY_PROMPTS_DIR=prompts

# --- Portal ---

RAY_HOST=127.0.0.1
RAY_PORT=8765
